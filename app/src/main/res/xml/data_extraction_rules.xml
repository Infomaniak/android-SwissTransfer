<!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="AccountPreferences" />

        <include domain="database" path="user_database" />
        <include domain="database" path="swisstransfer" />

        <include domain="sharedpref" path="AccountPreferences" />

        <include domain="file" path="AppSettings.realm" />
        <include domain="file" path="AppSettings.realm.management/" />

        <!-- Actual user id for this Realm DB is always -1. -->
        <include domain="file" path="Transfers--1.realm" />
        <include domain="file" path="Transfers--1.realm.management/" />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="thumbnails" />

        <include domain="database" path="." />

        <include domain="sharedpref" path="AccountPreferences" />

        <include domain="file" path="AppSettings.realm" />
        <include domain="file" path="AppSettings.realm.management/" />

        <include domain="file" path="AppSettings.realm" />
        <include domain="file" path="AppSettings.realm.management/" />

        <!-- Actual user id for this Realm DB is always -1. -->
        <include domain="file" path="Transfers--1.realm" />
        <include domain="file" path="Transfers--1.realm.management/" />
    </device-transfer>
</data-extraction-rules>
